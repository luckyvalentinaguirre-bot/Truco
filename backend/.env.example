# =============================================================
# Backend · Variables de entorno (EJEMPLO — sin valores reales)
# -------------------------------------------------------------
# Copiá este archivo como `.env` (en la raíz del repo o en backend/)
# y completá los valores. El .env real NUNCA se commitea.
# =============================================================

# Cadena de conexión a PostgreSQL (Neon). Formato:
#   postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
DATABASE_URL=

# Modo TLS para PostgreSQL: require | no-verify | disable  (Neon: require)
DATABASE_SSL=require

# Entorno: development | test | production
NODE_ENV=development

# Puerto reservado para el futuro servidor HTTP.
PORT=4000
